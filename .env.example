# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional. Use the deployed Neon Function URL for direct database submissions.
# Leave blank to use the local /api proxy during development.
VITE_NEON_API_BASE_URL=""

# Server-side GNews API key. Keep this secret out of client-side VITE_ variables.
GNEWS_API_KEY=""

# Google OAuth for /admin. Configure the OAuth client redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Web Push notifications. Generate these with web-push generate-vapid-keys.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://puntonochi.vercel.app"
CRON_SECRET=""

# Server-side YouTube Data API v3 key; never use a VITE_ prefix for this secret.
YOUTUBE_API_KEY=""

